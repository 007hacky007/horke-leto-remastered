# Turns files into a C++ table: hb::find_embedded("name") -> bytes. Runs at build time.
set(out "#include <cstddef>\n#include <cstring>\nnamespace hb {\nstruct Embedded { const char* name; const unsigned char* data; size_t size; };\n")
set(table "")
set(index 0)
foreach(file IN LISTS FILES)
  get_filename_component(name ${file} NAME)
  file(READ ${file} hex HEX)
  string(LENGTH "${hex}" length)
  math(EXPR bytes "${length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND out "static const unsigned char e${index}[] = {${hex}};\n")
  string(APPEND table "{\"${name}\", e${index}, ${bytes}},")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND out "static const Embedded table[] = {${table}};\nconst Embedded* find_embedded(const char* name) {\n  for (auto& e : table) if (!std::strcmp(e.name, name)) return &e;\n  return nullptr;\n}\n}\n")
file(WRITE ${OUTPUT} "${out}")
